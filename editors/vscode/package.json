{
  "name": "maka",
  "displayName": "Maka",
  "description": "Syntax highlighting for the Maka programming language (with embedded Rust in rblock and C in cblock).",
  "version": "0.1.0",
  "publisher": "mstampfli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mstampfli/maka"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "maka",
        "aliases": ["Maka", "maka"],
        "extensions": [".maka"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "maka",
        "scopeName": "source.maka",
        "path": "./syntaxes/maka.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.c": "c"
        }
      }
    ]
  }
}
