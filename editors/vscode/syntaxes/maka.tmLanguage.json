{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maka",
  "scopeName": "source.maka",
  "patterns": [
    { "include": "#comments" },
    { "include": "#rblock" },
    { "include": "#cblock" },
    { "include": "#strings" },
    { "include": "#char" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.maka"
    },
    "rblock": {
      "comment": "rblock \"...\" embeds Rust; highlight the body as Rust.",
      "begin": "\\b(rblock)\\s*(\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.ffi.maka" },
        "2": { "name": "string.quoted.double.maka" }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": { "0": { "name": "string.quoted.double.maka" } },
      "contentName": "meta.embedded.block.rust",
      "patterns": [{ "include": "source.rust" }]
    },
    "cblock": {
      "comment": "cblock \"...\" embeds C; highlight the body as C.",
      "begin": "\\b(cblock)\\s*(\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.ffi.maka" },
        "2": { "name": "string.quoted.double.maka" }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": { "0": { "name": "string.quoted.double.maka" } },
      "contentName": "meta.embedded.block.c",
      "patterns": [{ "include": "source.c" }]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.maka",
      "patterns": [
        {
          "match": "\\\\(n|t|r|0|\\\\|\"|x[0-9A-Fa-f]{2})",
          "name": "constant.character.escape.maka"
        },
        { "match": "\\\\.", "name": "invalid.illegal.escape.maka" }
      ]
    },
    "char": {
      "match": "'(\\\\(n|t|r|0|\\\\|'|x[0-9A-Fa-f]{2})|[^'\\\\])'",
      "name": "string.quoted.single.maka"
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9A-Fa-f_]+\\b", "name": "constant.numeric.hex.maka" },
        { "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b", "name": "constant.numeric.float.maka" },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.integer.maka" }
      ]
    },
    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.maka"
    },
    "keywords": {
      "patterns": [
        {
          "comment": "control flow",
          "match": "\\b(if|else|while|for|in|break|continue|match|yield|return|propagate|unsafe)\\b",
          "name": "keyword.control.maka"
        },
        {
          "comment": "declarations",
          "match": "\\b(data|enum|attr|has|logic|module|import|use|type|embed|where|dyn|some)\\b",
          "name": "keyword.declaration.maka"
        },
        {
          "comment": "modifiers / storage",
          "match": "\\b(mut|const|own|raw|pub|inline|gate|export|constexpr|thread_local|extern)\\b",
          "name": "storage.modifier.maka"
        },
        {
          "comment": "memory / ownership operations",
          "match": "\\b(alloc|free|transfer|share|as)\\b",
          "name": "keyword.other.maka"
        },
        {
          "comment": "FFI directives",
          "match": "\\b(cinclude|cblock|clink|rblock|rdep)\\b",
          "name": "keyword.other.ffi.maka"
        },
        {
          "comment": "the discard / wildcard placeholder",
          "match": "\\b_\\b",
          "name": "variable.language.maka"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "primitive and sized types",
          "match": "\\b(int|float|bool|char|string|unit|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64)\\b",
          "name": "storage.type.primitive.maka"
        },
        {
          "comment": "user types are PascalCase",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.maka"
        }
      ]
    },
    "function-call": {
      "comment": "an identifier immediately before ( is a call or declaration name; keywords already matched above",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.maka" } }
    },
    "operators": {
      "patterns": [
        { "match": "(==|!=|<=|>=|&&|\\|\\||<<|>>)", "name": "keyword.operator.maka" },
        { "match": "(\\+=|-=|\\*=|/=|%=)", "name": "keyword.operator.assignment.maka" },
        { "match": "(\\.\\.=|\\.\\.)", "name": "keyword.operator.range.maka" },
        { "match": "(::)", "name": "keyword.operator.path.maka" },
        { "match": "[-+*/%<>=&|\\^~!]", "name": "keyword.operator.maka" }
      ]
    }
  }
}
