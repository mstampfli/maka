// String: a growable, owned string - fully coded in Maka (std), backed by a
// NUL-terminated Vec<char>. Its ops are `attr StringOps` methods (push/push_str/
// length/as_str), called via dot syntax, plus operator sugar `+` (Add) and `==`
// (Eq). Trait methods coexist with same-named free functions. Auto-frees on
// drop. Leak-clean.
import std.{String, StringOps, Add, Eq, string_new, string_from};

// A free function named `push` - must coexist with String's `push` method.
data Counter { mut int n; }
unit push(&mut Counter c, int by) { c.n = c.n + by; }

unit main() {
  mut Counter c = Counter { n = 0 };
  push(&mut c, 5); push(&mut c, 2);
  log(c.n);                                            // 7  (free push)

  mut String s = string_new();
  s.push('h'); s.push('i');
  s.push_str(", world");
  log(s.length());                                     // 9  (String.push method)
  log(s.as_str());                                     // hi, world

  String t = string_from("hi") + string_from(", world");   // + operator (Add)
  if (s == t) { log(1); } else { log(0); }              // 1  (== operator, Eq)
  String u = string_from("nope");
  if (s == u) { log(1); } else { log(0); }              // 0
  log(s.as_str());                                      // hi, world  (s not consumed by ==)
}
