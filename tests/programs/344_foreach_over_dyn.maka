// foreach over a Vec (or array) of `&dyn T` must bind each element BY VALUE: a
// dyn is itself a fat pointer, so `&dyn T` and `dyn T` share one C type.  The
// bind-by-reference heuristic compared only the loop var's pointee to the element
// type (equal for a dyn element) and so emitted `Dyn_T x = &elem`, invalid C.
// Fix also requires the var's own type to differ from the element type.
import std.{Vec, push, String, StringOps, string_from};
data Dog  { mut String name; int legs; }
data Bird { mut String name; int legs; }
attr Animal {
  int legs(&_ self);
  int nlen(&_ self);
}
Dog has Animal {
  int legs(&Dog self)  { return self.legs; }
  int nlen(&Dog self)  { return self.name.length(); }
}
Bird has Animal {
  int legs(&Bird self) { return self.legs; }
  int nlen(&Bird self) { return self.name.length(); }
}
unit main() {
  mut int t = 0;
  for (int i in 0..1000) {
    Dog d  = { name = string_from("Rex"),    legs = 4 };
    Bird b = { name = string_from("Tweety"), legs = 2 };
    mut Vec<&dyn Animal> zoo = [];
    push(&mut zoo, &d as dyn Animal);
    push(&mut zoo, &b as dyn Animal);
    for (&dyn Animal a in zoo) { t = t + Animal.legs(a) + Animal.nlen(a); }
  }
  log(t);   // (4+3) + (2+6) = 7 + 8 = 15 ; *1000 = 15000
}
