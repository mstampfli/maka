// join(slice) waits for every handle in the slice to finish, in any order.
// All three closures sleep different amounts, then log their value; main
// continues only after all three have completed.
import std.{sleep_ms};

unit short_sleep(int ms) { sleep_ms(ms); }

unit main() {
    [3]*Thread handles = [
        spawn(unit() { short_sleep(30); log(1); }),
        spawn(unit() { short_sleep(10); log(2); }),
        spawn(unit() { short_sleep(20); log(3); }),
    ];
    []*Thread s = handles;
    join(s);
    log(0);
}
