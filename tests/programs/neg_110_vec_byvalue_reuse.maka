// A native Vec<T> passed by value into Rust transfers ownership (the shim frees
// the buffer), so reusing it after the consuming call is rejected (move check).
rblock "
    pub fn mk(n:i64)->Vec<i64> { (1..=n).collect() }
    pub fn sum(v:Vec<i64>)->i64 { v.iter().sum() }
";
unit main() {
    Vec<int> v = mk(5);
    log(sum(v));
    log(sum(v));   // reuse of moved v
}
