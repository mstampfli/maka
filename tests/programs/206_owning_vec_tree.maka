import std.Vec;

data Node {
    int val;
    mut Vec<own *Node> kids;
}

mut int g_counter = 0;

own *Node build(int depth, int branch) {
    int myval = g_counter;
    g_counter = g_counter + 1;
    own *Node n = alloc Node { val = myval, kids = [] };
    if (depth > 0) {
        mut int i = 0;
        while (i < branch) {
            own *Node child = build(depth - 1, branch);
            push(n!.kids, child);
            i = i + 1;
        }
    }
    return n;
}

int sum(*Node n) {
    if (n == null) { return 0; }
    mut int total = n!.val;
    for (usize i in 0..n!.kids.len) {
        total = total + sum(n!.kids[i]);
    }
    return total;
}

int node_count(*Node n) {
    if (n == null) { return 0; }
    mut int c = 1;
    for (usize i in 0..n!.kids.len) {
        c = c + node_count(n!.kids[i]);
    }
    return c;
}

int depth_of(*Node n) {
    if (n == null) { return 0; }
    mut int best = 0;
    for (usize i in 0..n!.kids.len) {
        int d = depth_of(n!.kids[i]);
        if (d > best) { best = d; }
    }
    return best + 1;
}

unit main() {
    own *Node root = build(3, 3);   // 1+3+9+27 = 40 nodes
    log(node_count(root));   // 40
    log(depth_of(root));     // 4
    log(sum(root));          // 0..39 -> 780
}
