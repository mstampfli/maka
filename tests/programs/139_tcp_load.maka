// Multi-connection TCP load test.  Server accepts 100 connections in a
// loop, spawns a fiber per connection that echoes one 4-byte payload.
// Client fires 100 connect+write+read pairs in parallel.
//
// Exercises: per-fd waiter list, fiber scheduler under load, atomic
// counter coordination, WaitGroup, multi-fiber wait_fd, accept_async.

import std.{ Atomic, Mutex, WaitGroup, Once, 
    tcp_listen, tcp_accept_async, tcp_connect_v4, close_fd,
    read_async, write_async,
    atomic_new, atomic_get, atomic_add, atomic_destroy,
    wg_new, wg_add, wg_done, wg_wait, wg_destroy,
};

cblock "
    static maka_unit* __mk_msg(void) { static unsigned char m[4] = {'P','I','N','G'}; return (maka_unit*)m; }
    static maka_unit* __mk_alloc_buf(void) { return (maka_unit*)calloc(1, 16); }
    static int        __mk_first_byte(maka_unit* buf) { return (int)((unsigned char*)buf)[0]; }
    static void       __mk_free_buf(maka_unit* buf) { free(buf); }
";
extern *unit __mk_msg();
extern *unit __mk_alloc_buf();
extern i32   __mk_first_byte(*unit buf);
extern unit  __mk_free_buf(*unit buf);

mut int g_port = 0;

unit serve_one(int cfd, Atomic<int> ok_count, WaitGroup wg) {
    unsafe {
        *unit buf = __mk_alloc_buf();
        int n = read_async(cfd, buf, 4);
        if (n == 4) {
            _ = write_async(cfd, buf, 4);
            _ = atomic_add(ok_count, 1);
        }
        __mk_free_buf(buf);
    }
    _ = close_fd(cfd);
    wg_done(wg);
}

unit server_body(int listen_fd, int n_conns, Atomic<int> ok_count, WaitGroup wg) {
    for (int i in 0..n_conns) {
        int cfd = tcp_accept_async(listen_fd);
        *Thread t = spawn(unit() [cfd, ok_count, wg] { serve_one(cfd, ok_count, wg); });
        detach(t);
    }
}

unit client_one(int port, Atomic<int> ok_count, WaitGroup wg) {
    int s = tcp_connect_v4(127, 0, 0, 1, port);
    if (s >= 0) {
        unsafe {
            _ = write_async(s, __mk_msg() as *mut unit, 4);
            *unit buf = __mk_alloc_buf();
            int n = read_async(s, buf, 4);
            if (n == 4 && __mk_first_byte(buf) as int == 80) {
                _ = atomic_add(ok_count, 1);
            }
            __mk_free_buf(buf);
        }
        _ = close_fd(s);
    }
    wg_done(wg);
}

unit main() {
    int N = 100;
    g_port = 39119;
    int listen_fd = tcp_listen(g_port, 256);

    Atomic<int>    srv_ok = atomic_new(0);
    Atomic<int>    cli_ok = atomic_new(0);
    WaitGroup srv_wg = wg_new();
    WaitGroup cli_wg = wg_new();

    wg_add(srv_wg, N);
    *Thread server = spawn(unit() [listen_fd, N, srv_ok, srv_wg] {
        server_body(listen_fd, N, srv_ok, srv_wg);
    });
    detach(server);

    wg_add(cli_wg, N);
    for (int i in 0..N) {
        *Thread c = spawn(unit() [cli_ok, cli_wg] {
            client_one(g_port, cli_ok, cli_wg);
        });
        detach(c);
    }

    wg_wait(srv_wg);
    wg_wait(cli_wg);

    log(atomic_get(srv_ok));   // 100
    log(atomic_get(cli_ok));   // 100

    _ = close_fd(listen_fd);
    atomic_destroy(srv_ok); atomic_destroy(cli_ok);
    wg_destroy(srv_wg); wg_destroy(cli_wg);
}
