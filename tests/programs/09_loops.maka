// §8 — Control flow: while, if/else, return.
int sum_to(int n) {
    mut int s = 0;
    mut int i = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

unit main() {
    int t = sum_to(10);
    log(t);         // 55
    if (t > 50) {
        log("big");
    } else {
        log("small");
    }
}
