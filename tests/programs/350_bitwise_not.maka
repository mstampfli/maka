// Bitwise NOT (`~`): integer-only, result keeps the operand type, so it is masked
// back to the type width (`~(u8)0` is 255, not the C-promoted -1).
unit main() {
  log(~5);            // -6
  log(~0 + 1);        // 0   (~0 == -1)
  int mask = 12;
  log(255 & ~mask);   // 243 (255 & ~12)
  u8 a = 0 as u8;
  log((~a) as int);   // 255
  u16 b = 0 as u16;
  log((~b) as int);   // 65535
  i8 c = 0 as i8;
  log((~c) as int);   // -1
  u32 d = 0 as u32;
  if ((~d) as i64 == 4294967295) { log(1); } else { log(0); }  // 1
}
