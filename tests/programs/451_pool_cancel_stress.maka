// Cancel-stress: 60 fibers spawned on a Pool, each handle cancelled immediately.
// Hits every cancel state under work-stealing: a still-ready fiber in a deque
// (lazy-flagged, reaped at dequeue via __maka_reap_cancelled), a running fiber
// (cooperative, runs to completion), and an already-done fiber.  Must neither
// crash, hang, nor leak.  Prints "ok".
import std.{ Pool, pool, pool_shutdown };
import std.sleep_us;
unit main() {
    Pool p = pool(3);
    for (int i in 0..60) { *Thread t = spawn_on(p, unit() { sleep_us(50); }); cancel(t); }
    log("ok");
    pool_shutdown(p);
}
