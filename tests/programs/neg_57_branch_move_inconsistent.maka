// An owning pointer moved on only one (non-diverging) branch is AUTO-NULLED at
// the merge (SPEC 6.4), not hard-errored. Dereferencing it after the `if`,
// without re-proving non-null, is then rejected by the forced-handling rule
// (SPEC 6.3) - an `own *T` errors only on a missing non-null proof.
data Box { int v; }
unit eat(own *Box b) { }
int f(int c) {
    own *Box x = alloc Box { v = 7 };
    if (c > 0) { eat(x); }   // conditional move -> x auto-nulls at the join
    return x!.v;             // ERROR: deref without a fresh non-null proof
}
unit main() { log(f(1)); }
