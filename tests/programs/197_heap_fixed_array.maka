// `own *[N]T` / `own &[N]T` - a fixed-size array on the heap (one malloc,
// auto-freed).  Read, write-through, `.len`, and use as a struct field.
data Grid { own &[3]int row; }
unit main() {
    own *[4]int p = alloc [10, 20, 30, 40];
    if (p != null) {
        p![2] = 99;
        mut int s = 0;
        for (int i in 0..(p!.len as int)) { s = s + p![i]; }
        log(s);                  // 10+20+99+40 = 169
    }
    Grid g = { row = alloc [7, 8, 9] };
    log(g.row[1]);               // 8
    log(g.row.len as int);       // 3
}
