data Cat { int n; }
data Dog { int n; }
attr Speak { int sound(&_ self); }
Cat has Speak { int sound(&Cat self) { return self.n + 1; } }
Dog has Speak { int sound(&Dog self) { return self.n + 2; } }
unit main() {
    Cat c = { n = 10 };
    Dog d = { n = 20 };
    &dyn Speak a = &c as dyn Speak;
    &dyn Speak b = &d as dyn Speak;
    log(Speak.sound(&a));   // 11
    log(Speak.sound(&b));   // 22
}
