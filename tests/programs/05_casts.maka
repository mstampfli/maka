// §3 — Type casts.  `as` is the cast operator.  Whether a check fires is
// read off the *types*, not from a separate sigil: `int as Enum` is
// runtime-bounds-checked against the variant set (panics on OOB, same
// shape as `arr[i]`); `int as char` truncates to the low 8 bits.
enum MovementState {
    Idle,
    Walking,
    Running,
}

unit main() {
    int i = 42;
    float fv = i as float;
    log(fv);                                 // 42

    float pi = 3.75;
    int n = pi as int;
    log(n);                                  // 3

    MovementState s = MovementState.Walking;
    int code = s as int;
    log(code);                               // 1

    int tag_val = 2;
    MovementState parsed = tag_val as MovementState;
    log(parsed as int);                      // 2 (= Running)
}
