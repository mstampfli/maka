// Transferring an owner across a gate moves it into the gate, which frees it, so a
// `*T` alias of that owner dangles - using it after the transfer is a heap-use-
// after-free.  The Transfer handler marked the source moved but did not poison its
// aliases (unlike the by-value move path), so this was accepted.  Now transfer of
// an owner pointer poisons its aliases.
data Box { int v; }
gate int consume(own *Box b) { mut int r = 0; if (b != null) { r = b!.v; } return r; }
int f() {
  own *Box owner = alloc Box { v = 7 };
  *Box alias = owner;
  int d = consume(transfer owner);
  if (alias != null) { return alias!.v; }
  return d;
}
unit main() { log(f()); }
