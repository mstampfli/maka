// Override beats default: an `attr` default method body is the fallback, and a
// type's `has` impl overrides it (the attr+has analog of concrete-beats-generic).
data Player { mut int hp = 100; }
data Enemy  { mut int aggro = 0; }
data Rock   { int mass; }

attr Movement {
    unit move(&mut _ self) { log("generic move"); }   // default body = fallback
}
Player has Movement {
    unit move(&mut Player self) {
        log("player move");
        self.hp = self.hp - 1;
    }
}
Enemy has Movement {
    unit move(&mut Enemy self) { log("enemy move"); }
}
Rock has Movement { }   // no override -> inherits the default

unit main() {
    mut Player p = { hp = 5 };
    mut Enemy  e = { aggro = 7 };
    mut Rock   r = { mass = 100 };
    Movement.move(&mut p);
    log(p.hp);             // 4
    Movement.move(&mut e); // enemy move
    Movement.move(&mut r); // generic move (default)
}
