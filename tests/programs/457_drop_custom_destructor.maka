import std.{ Drop };
cblock "
    #include <stdlib.h>
    maka_unit* __res_open(void) { return (maka_unit*)malloc(32); }
    void       __res_close(maka_unit* p) { free(p); }   /* custom destructor that frees */
";
extern "__res_open"  raw *unit res_open();
extern "__res_close" unit      res_close(raw *unit p);
// Custom-destructor handle: raw (non-owning) field, so Maka frees nothing;
// Drop does the complete teardown. Move-only via Drop. Like a FILE*/socket.
data Res { raw *unit fd; }
Res has Drop { unit drop(&mut Res self) { unsafe { res_close(self.fd); } log(7); } }
Res open() { unsafe { Res r = { fd = res_open() }; return r; } }
unit main() {
    { Res a = open(); }        // a drops -> res_close(fd) + log 7. Maka frees nothing.
    { Res b = open(); }         // -> 7
    log(0);
}
