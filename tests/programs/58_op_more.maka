// Extended operator overloading: BitAnd (stdlib trait), unary Neg and Index
// (declared here - they are not stdlib traits), all via attr + has.
data Vec3 {
    int x;
    int y;
    int z;
}

Vec3 has BitAnd {
    Vec3 band(&Vec3 self, &Vec3 b) {
        return Vec3 { x = self.x & b.x, y = self.y & b.y, z = self.z & b.z };
    }
}

attr Neg { _ neg(&_ self); }
Vec3 has Neg {
    Vec3 neg(&Vec3 self) {
        return Vec3 { x = -self.x, y = -self.y, z = -self.z };
    }
}

attr Index { int index(&_ self, int i); }
Vec3 has Index {
    int index(&Vec3 self, int i) {
        if (i == 0) { return self.x; }
        if (i == 1) { return self.y; }
        return self.z;
    }
}

unit main() {
    // Built-in bitwise on int:
    log(0xF0 & 0x3F);    // 0x30 = 48
    log(0xF0 | 0x0F);    // 0xFF = 255
    log(0xAB ^ 0xCD);    // 0x66 = 102
    log(1 << 4);         // 16
    log(64 >> 2);        // 16

    // Overloaded on Vec3:
    Vec3 a = Vec3 { x = 7, y = 12, z = 5 };
    Vec3 b = Vec3 { x = 3, y = 10, z = 6 };
    Vec3 c = a & b;
    log(c.x);            // 7 & 3 = 3
    log(c.y);            // 12 & 10 = 8
    log(c.z);            // 5 & 6 = 4

    Vec3 d = -a;
    log(d.x);            // -7
    log(d.y);            // -12
    log(d.z);            // -5

    log(a[0]);           // 7
    log(a[1]);           // 12
    log(a[2]);           // 5
}
