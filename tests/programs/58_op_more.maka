// Extended operator overloading: BitAnd/BitOr/BitXor/Shl/Shr, unary Neg, Index.
data Vec3 {
    int x;
    int y;
    int z;
}

logic BitAnd {
    Vec3 band(Vec3 a, Vec3 b) {
        return Vec3 { x = a.x & b.x, y = a.y & b.y, z = a.z & b.z };
    }
}

logic Neg {
    Vec3 neg(Vec3 a) {
        return Vec3 { x = -a.x, y = -a.y, z = -a.z };
    }
}

logic Index {
    int index(Vec3 a, int i) {
        if (i == 0) { return a.x; }
        if (i == 1) { return a.y; }
        return a.z;
    }
}

unit main() {
    // Built-in bitwise on int:
    log(0xF0 & 0x3F);    // 0x30 = 48
    log(0xF0 | 0x0F);    // 0xFF = 255
    log(0xAB ^ 0xCD);    // 0x66 = 102
    log(1 << 4);         // 16
    log(64 >> 2);        // 16

    // Overloaded on Vec3:
    Vec3 a = Vec3 { x = 7, y = 12, z = 5 };
    Vec3 b = Vec3 { x = 3, y = 10, z = 6 };
    Vec3 c = a & b;
    log(c.x);            // 7 & 3 = 3
    log(c.y);            // 12 & 10 = 8
    log(c.z);            // 5 & 6 = 4

    Vec3 d = -a;
    log(d.x);            // -7
    log(d.y);            // -12
    log(d.z);            // -5

    log(a[0]);           // 7
    log(a[1]);           // 12
    log(a[2]);           // 5
}
