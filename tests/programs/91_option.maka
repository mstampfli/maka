// `Option<T>` lives in `stdlib/std.maka` and requires an explicit import
// just like any cross-module type.  Generic enums monomorphize the same as
// generic structs: `Option<int>`, `Option<string>` each get distinct enums.
import std.Option;

unit main() {
    Option<int> a = Option.Some{ value = 42 };
    Option<int> b = Option.None;

    int got_a = match (a) {
        Some{value} value,
        None 0,
    };
    log(got_a);    // 42

    int got_b = match (b) {
        Some{value} value,
        None -1,
    };
    log(got_b);    // -1
}
