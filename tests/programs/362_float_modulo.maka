// Regression: floating-point modulo. C's `%` is integer-only, so `f64 % f64` was
// emitted as `a % b` and failed to compile; it now lowers to __builtin_fmod
// (no <math.h>/-lm dependency).
unit main() {
  f64 a = 7.5;
  f64 b = 2.0;
  log((a % b) as int);                  // 7.5 % 2.0 = 1.5 -> 1
  log(((10.0 % 3.0) * 100.0) as int);   // 1.0 * 100 -> 100
  log(((0.0 - 7.5) % 2.0) as int);      // -7.5 % 2.0 = -1.5 -> -1
}
