// Calling a where-bounded generic with a type that doesn't implement the bound.
data Color { int rgb; }
data Number { int n; }

attr Drawable { unit draw(&_ self); }
Color has Drawable { unit draw(&Color self) { log(self.rgb); } }

unit render<T>(&T x) where T has Drawable { }

unit main() {
    Number n = { n = 5 };
    render(&n);    // Number doesn't implement Drawable
}
