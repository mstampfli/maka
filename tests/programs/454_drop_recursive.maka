// Drop on a pointee `R`: `own *R` cleanup calls R's drop then frees. Recursive
// through an owning container; a moved own*R drops once (source auto-nulled).
// A `has Drop` type is NOT owning by-value - you hold it as `own *R`.
import std.{ Drop };

data R { int id; }
R has Drop { unit drop(&mut R self) { log(self.id); } }

data Two { own *R a; own *R b; }   // two owning pointers, each drops via own*

unit main() {
    { own *R x = alloc R { id = 1 }; }                                            // 1
    { own *Two t = alloc Two { a = alloc R { id = 2 }, b = alloc R { id = 3 } }; } // 2 3
    { own *R p = alloc R { id = 5 }; own *R q = p; }                              // 5 once (p -> q)
    log(0);
}
