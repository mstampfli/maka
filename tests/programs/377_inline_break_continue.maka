// break/continue inside an inline fn body target the CALLER's loop (inline is a
// splice).  Previously the inline expansion's vestigial `do{}while(0)` (and, for an
// enum match, the `switch`) captured the jump, so it silently exited the expansion
// instead of the loop and the loop's owning locals were freed twice / lost.  Now
// the expansion is a plain block, an inline match with a break/continue uses the
// if-chain form, and the jump frees both the inline's and the caller loop's owning
// locals.  Verified ASan/LSan clean.
import std.{String, StringOps, string_from};

enum Sig { Go, Stop }

// non-enum match: break out of the caller's loop from the inline.
inline int step_break(int i, int stopAt) {
  return match (i == stopAt) { true { break; } else { yield 1; } };
}
int run_break(int stopAt) {
  mut int total = 0;
  for (int i in 0..10) { String c = string_from("LP"); total = total + step_break(i, stopAt) + c.length(); }
  return total;
}

// enum match: break, with an owning loop-body local in the caller.
inline int step_enum(Sig s) {
  return match (s) { Sig.Stop { break; } Sig.Go { yield 1; } };
}
int run_enum(int stopAt) {
  mut int total = 0;
  for (int i in 0..10) {
    String c = string_from("Z");
    Sig s = if (i == stopAt) { yield Sig.Stop; } else { yield Sig.Go; };
    total = total + step_enum(s) + c.length();
  }
  return total;
}

// continue: skip even iterations from the inline.
inline int step_cont(int i) {
  return match (i % 2 == 0) { true { continue; } else { yield 1; } };
}
int run_cont() {
  mut int total = 0;
  for (int i in 0..6) { String c = string_from("LP"); total = total + step_cont(i) + c.length(); }
  return total;
}

// NESTED: an inline (n_inner) breaks; another inline (n_outer) calls it; n_outer is
// called in the caller's loop.  The break frees the inner's locals, the intermediate
// frame's own local (s), AND the caller loop local - every active inline frame.
inline int n_inner(int i, int stopAt) { return match (i == stopAt) { true { break; } else { yield 1; } }; }
inline int n_outer(int i, int stopAt) { String s = string_from("OF"); int v = n_inner(i, stopAt); return v + s.length(); }
int run_nested(int stopAt) {
  mut int total = 0;
  for (int i in 0..10) { String c = string_from("LP"); total = total + n_outer(i, stopAt) + c.length(); }
  return total;
}

unit main() {
  log(run_break(3));   // i=0,1,2 -> (1+2)=3 each -> 9, then break -> 9
  log(run_enum(3));    // i=0,1,2 -> (1+1)=2 each -> 6, then break -> 6
  log(run_cont());     // odd i (1,3,5) -> 1 + len("LP")=2 -> 3 each -> 9
  log(run_nested(3));  // i=0,1,2 -> n_outer=1+len("OF")=3, +len("LP")=2 -> 5 each -> 15, then break -> 15
}
