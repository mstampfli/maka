// Atomic<i64>, fiber-aware Mutex, WaitGroup, Once.
// 16 fibers each: atomically increment a counter, lock a mutex to
// increment a non-atomic counter, run once_do, and signal the wait group.

import std.{
    Atomic, Mutex, WaitGroup, Once,
    atomic_new, atomic_get, atomic_add, atomic_destroy,
    mutex_new, mutex_lock, mutex_unlock, mutex_destroy,
    wg_new, wg_add, wg_done, wg_wait, wg_destroy,
    once_new, once_do, once_destroy,
};

mut int once_runs = 0;
mut int locked_counter = 0;

unit main() {
    Atomic<int>    a  = atomic_new(0);
    Mutex     mu = mutex_new();
    WaitGroup wg = wg_new();
    Once      o  = once_new();

    int N = 16;
    wg_add(wg, N);

    for (int i in 0..N) {
        *Thread t = spawn(unit() [a, mu, wg, o] {
            _ = atomic_add(a, 1);
            mutex_lock(mu);
            locked_counter = locked_counter + 1;
            mutex_unlock(mu);
            once_do(o, unit() { once_runs = once_runs + 1; });
            wg_done(wg);
        });
        _ = t;
    }

    wg_wait(wg);
    log(atomic_get(a));    // 16
    log(locked_counter);   // 16
    log(once_runs);        // 1

    atomic_destroy(a);
    mutex_destroy(mu);
    wg_destroy(wg);
    once_destroy(o);
}
