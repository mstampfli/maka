// Multi-fiber wait_fd on the same fd.  Without the per-fd registration
// rework, the second fiber's epoll registration would overwrite the
// first's data.ptr and the first would never wake.  Now both wake and
// drain the pipe collectively.

import std.{wait_fd, read_async, write_async, set_nonblock, EV_READ, EV_WRITE, sleep_ms};

cblock "
    #include <unistd.h>
    static int __mk_rfd = -1, __mk_wfd = -1;
    static int  __mk_open_pipe(void) {
        int fds[2];
        if (pipe(fds) != 0) return -1;
        __mk_rfd = fds[0]; __mk_wfd = fds[1];
        return 0;
    }
    static int  __mk_rfd_get(void) { return __mk_rfd; }
    static int  __mk_wfd_get(void) { return __mk_wfd; }
    static maka_unit* __mk_buf1(void) { static unsigned char buf[1] = {0}; return (maka_unit*)buf; }
    static int  __mk_buf1_at(int i) {
        unsigned char* b = (unsigned char*)__mk_buf1();
        return (int)b[i];
    }
    static maka_unit* __mk_msg1A(void) { static unsigned char m[1]={65}; return (maka_unit*)m; }
    static maka_unit* __mk_msg1B(void) { static unsigned char m[1]={66}; return (maka_unit*)m; }
";

extern i32   __mk_open_pipe();
extern i32   __mk_rfd_get();
extern i32   __mk_wfd_get();
extern *unit __mk_buf1();
extern i32   __mk_buf1_at(i32 i);
extern *unit __mk_msg1A();
extern *unit __mk_msg1B();

mut int reads_done = 0;

unit reader_body() {
    int rfd = __mk_rfd_get() as int;
    wait_fd(rfd, EV_READ);
    int n = read_async(rfd, __mk_buf1() as *mut unit, 1);
    if (n == 1) {
        log(__mk_buf1_at(0 as i32) as int);
        reads_done = reads_done + 1;
    }
}

unit main() {
    _ = __mk_open_pipe();
    _ = set_nonblock(__mk_rfd_get() as int);
    _ = set_nonblock(__mk_wfd_get() as int);

    *Thread r1 = spawn(unit() { reader_body(); });
    *Thread r2 = spawn(unit() { reader_body(); });

    sleep_ms(5);     // let both readers park in wait_fd
    int wfd = __mk_wfd_get() as int;
    _ = write_async(wfd, __mk_msg1A() as *mut unit, 1);
    sleep_ms(5);
    _ = write_async(wfd, __mk_msg1B() as *mut unit, 1);

    join(r1);
    join(r2);
    log(reads_done);    // 2
}
