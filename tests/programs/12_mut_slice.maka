// Mutable slices written through a function param.
unit bump_all([]mut int xs) {
    mut int i = 0;
    while (i < 3) {
        xs[i] = xs[i] + 1;
        i = i + 1;
    }
}

unit main() {
    mut [3]int a = [10, 20, 30];
    []mut int s = a;
    bump_all(s);
    log(a[0]);    // 11
    log(a[1]);    // 21
    log(a[2]);    // 31
}
