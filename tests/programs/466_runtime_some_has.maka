import std.{Vec, push};
data Gram { int g; }
data Kilo { int k; }
attr Weigh { int weight(&_ self); }
attr Dense { int density(&_ self); }
Gram has Weigh { int weight(&Gram self) { return self.g; } }
Gram has Dense { int density(&Gram self) { return 100; } }
Kilo has Weigh { int weight(&Kilo self) { return self.k * 1000; } }
unit main() {
    Vec<Gram> grams = []; push(grams, Gram { g = 2 });
    Vec<Kilo> kilos = []; push(kilos, Kilo { k = 1 });
    Vec<Vec<some Weigh>> columns = [];
    push(columns, grams);
    push(columns, kilos);
    for (Vec<some Weigh> col in columns) {
        for (some Weigh item in col) {
            if (item has Dense) { log(Dense.density(&item)); } else { log(-1); }
        }
    }
}
