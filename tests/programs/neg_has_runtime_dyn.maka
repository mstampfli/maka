// `has` on an existential (`dyn`/`some`) value would need a RUNTIME type check
// (the concrete type is hidden); that is not yet supported - only compile-time
// `T has X` on a concrete type / type parameter folds.  Must be rejected.
attr Speak { int sound(&_ self); }
attr Other { int x(&_ self); }
data Cat { int c; }
Cat has Speak { int sound(&Cat self) { return 1; } }
unit main() {
    Cat c = { c = 1 };
    &dyn Speak d = &c as dyn Speak;
    if (d has Other) { log(1); } else { log(0); }
}
