// wait_fd_timeout — bounded wait on an fd inside a fiber.  Returns
// true on event, false on timeout.  Here the pipe is never written so
// the wait must time out.
import std.{wait_fd_timeout, set_nonblock, EV_READ};

cblock "
    #include <unistd.h>
    static int __mk_rfd = -1, __mk_wfd = -1;
    static int __mk_open_pipe(void) {
        int fds[2];
        if (pipe(fds) != 0) return -1;
        __mk_rfd = fds[0]; __mk_wfd = fds[1];
        return 0;
    }
    static int __mk_rfd_get(void) { return __mk_rfd; }
";
extern i32 __mk_open_pipe();
extern i32 __mk_rfd_get();

unit waiter_body() {
    if (wait_fd_timeout(__mk_rfd_get() as int, EV_READ, 20)) { log(1); } else { log(0); }
}

unit main() {
    _ = __mk_open_pipe();
    _ = set_nonblock(__mk_rfd_get() as int);
    *Thread w = spawn(unit() { waiter_body(); });
    join(w);
}
