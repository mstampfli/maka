// D11 — multi-threaded counter via pthread + atomic.
extern i64 maka_atomic_fetch_add_i64(&mut i64 p, i64 delta);
extern i64 maka_atomic_load_i64(&i64 p);
extern *i64 maka_thread_spawn_counter(&mut i64 counter, i64 iters);
extern unit maka_thread_join(*i64 handle);

unit main() {
    mut int counter = 0;
    *int t1 = maka_thread_spawn_counter(&mut counter, 1000);
    *int t2 = maka_thread_spawn_counter(&mut counter, 1000);
    maka_thread_join(t1);
    maka_thread_join(t2);
    log(maka_atomic_load_i64(&counter));   // 2000
}
