// Intra-file modules as function namespaces: several modules in one file.
module math {
    pub int square(int x) { return x * x; }
    pub int cube(int x) { return x * x * x; }
}

module greet {
    pub unit hello() { log("hi from greet"); }
}

import math.square;
import math.cube;
import greet.hello;

unit main() {
    int s = math.square(5);
    log(s);                  // 25
    int c = math.cube(3);
    log(c);                  // 27
    greet.hello();           // hi from greet
}
