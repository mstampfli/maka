// `if (cond) { ... } else { ... }` is now a value-yielding expression
// (desugars to a bool match).  `else if` chains nest naturally.
int absi(int n) {
    return if (n < 0) { yield -n; } else { yield n; };
}

int sign(int n) {
    return if (n > 0) { yield 1; }
           else if (n < 0) { yield -1; }
           else { yield 0; };
}

unit main() {
    log(absi(-7));      // 7
    log(absi(3));       // 3
    log(sign(-5));      // -1
    log(sign(0));       // 0
    log(sign(42));      // 1
}
