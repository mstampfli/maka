// try_join(*Thread) — non-blocking poll.  Returns false while running,
// true once finished (and reclaims the handle exactly once).
import std.sleep_ms;

unit main() {
    // Sleep gaps wide enough to survive Windows' ~15.6 ms timer resolution.
    *Thread t = spawn(unit() { sleep_ms(50); });
    if (try_join(t)) { log(1); } else { log(0); }     // 0 — not done yet
    sleep_ms(150);
    if (try_join(t)) { log(1); } else { log(0); }     // 1 — done now
}
