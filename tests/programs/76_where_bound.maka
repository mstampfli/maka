// `where T has Trait` is enforced - `T` must have a matching `has` impl.
data Color { int rgb; }

attr Drawable { unit draw(&_ self); }
Color has Drawable { unit draw(&Color self) { log(self.rgb); } }

// Generic function constrained to Drawable types.
unit render<T>(&T x) where T has Drawable {
    // body intentionally empty; the bound check happens at instantiation.
}

unit main() {
    Color c = { rgb = 255 };
    render(&c);    // Color implements Drawable - OK
    log(0);
}
