// Composition: an owner moved INSIDE a match arm invalidates a `*T` alias of it;
// using the alias AFTER the match (on the path where that arm ran) is a heap-use-
// after-free.  The BorrowCk match-arm join only propagated `moved`, so the alias
// poison set inside the arm was lost past the join and the dangling use slipped
// through.  Now the join also unions poison/holds_dying_borrow from non-diverging
// arms, so this is rejected at compile time.
data Box { int v; }
int consume(own *Box b) { mut int r = 0; if (b != null) { r = b!.v; } return r; }
int f(int c) {
  own *Box owner = alloc Box { v = 7 };
  *Box alias = owner;
  mut int acc = match (c) { 0 { int d = consume(owner); yield d; } else { yield 0; } };
  if (alias != null) { acc = acc + alias!.v; }
  return acc;
}
unit main() { log(f(0)); }
