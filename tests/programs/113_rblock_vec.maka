// `Vec<T>` mirrors as a NATIVE Maka `Vec<T>` (its `{ptr,len,cap}` ABI struct is
// layout-compatible), so from pure Maka you get `.len`, `for x in v`, and `v[i]`
// (bounds-checked) with no raw-pointer arithmetic. Passing a Vec back into Rust
// still transfers ownership (a move); the shim frees the libc-malloc'd buffer.
rblock "
    pub fn make_squares(n: i64) -> Vec<i64> { (1..=n).map(|i| (i*i) as i64).collect() }
    pub fn sum_of(v: Vec<i64>) -> i64 { v.iter().sum() }
";

unit main() {
    Vec<int> v = make_squares(5);
    log(v.len as int);                 // 5
    mut int s = 0;
    for (int x in v) { s = s + x; }    // native iteration
    log(s);                            // 55
    log(v[4]);                         // 25  (native indexing)
    log(sum_of(v));                    // pass back into Rust (move) -> 55
}
