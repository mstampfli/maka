// Owning temporaries consumed inline (a borrowing call argument, or a discarded
// expression) are freed - they are hoisted into hidden owning locals.  Passing
// an owning temp to an `own` parameter still transfers ownership (no
// double-free).  Leak-freedom is verified out of band with LeakSanitizer.

import std.str_len;

data Box { mut int v; }
int take_str(string s) { return str_len(s) as int; }
unit consume(own *Box b) { if (b != null) { log(b!.v); } }

unit main() {
    mut int i = 0;
    while (i < 3) { log(format("row {}", i)); i = i + 1; }  // owning str temp -> log, per iter
    log(take_str(format("ab{}", 9)));                        // -> user borrow fn  (str_len "ab9" = 3)
    _ = format("discard {}", 1);                             // discarded owning temp
    consume(alloc Box { v = 42 });                           // -> own param: transferred, not double-freed
}
