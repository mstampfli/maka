data Cat { int n; }
data Dog { int n; }
attr Speak { int sound(&_ self); }
Cat has Speak { int sound(&Cat self) { return self.n; } }
Dog has Speak { int sound(&Dog self) { return self.n * 10; } }
int total([]&dyn Speak xs) {
    mut int s = 0;
    mut int i = 0;
    while (i < xs.len as int) { s = s + Speak.sound(&xs[i]); i = i + 1; }
    return s;
}
unit main() {
    Cat c = { n = 1 };
    Dog d = { n = 2 };
    [2]&dyn Speak arr = [&c as dyn Speak, &d as dyn Speak];
    log(total(arr));   // 1 + 20 = 21
}
