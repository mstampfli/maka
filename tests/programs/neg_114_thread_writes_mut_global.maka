// Regression (bug R): a `mut` module global read-modify-written by two real OS
// threads must be rejected.  The cross-thread CAPTURE check never inspects globals
// (they are referenced by name, not captured), so this raced-but-compiled clean.
// The interprocedural pass now flags any mut global transitively written from a
// thread body - here `counter` is written by `bump()`, which each thread runs.
mut int counter = 0;

unit bump() {
    mut int i = 0;
    while (i < 100000) {
        counter = counter + 1;
        i = i + 1;
    }
}

unit main() {
    *Thread t1 = thread(unit() { bump(); });
    *Thread t2 = thread(unit() { bump(); });
    join(t1);
    join(t2);
    log(counter);
}
