// rblock: &str / String round-trip through generated shims.  Rust receives a
// borrowed string and returns an owned Rust String, which Maka auto-frees as an
// `own *string`.
rblock "
    pub fn shout(s: &str) -> String { s.to_uppercase() }
    pub fn count_letter(s: &str, ch: i32) -> i64 {
        s.chars().filter(|c| (*c as i32) == ch).count() as i64
    }
";

unit main() {
    log(shout("hello rust"));   // HELLO RUST
    log(count_letter("banana", 97));  // 97 = 'a' → 3
}
