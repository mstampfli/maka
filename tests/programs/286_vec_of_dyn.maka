import std.{Vec, push};
data Cat { int n; }
data Dog { int n; }
attr Speak { int sound(&_ self); }
Cat has Speak { int sound(&Cat self) { return self.n; } }
Dog has Speak { int sound(&Dog self) { return self.n * 10; } }
unit main() {
    Cat c = { n = 1 };
    Dog d = { n = 2 };
    Vec<&dyn Speak> animals = [];
    push(animals, &c as dyn Speak);
    push(animals, &d as dyn Speak);
    mut int sum = 0;
    mut int i = 0;
    while (i < animals.len as int) {
        sum = sum + Speak.sound(&animals[i]);
        i = i + 1;
    }
    log(sum);   // 1 + 20 = 21
}
