// Intra-file module blocks: one file declares several modules.  `math` is a
// real module - its items resolve, import, and enforce `pub` exactly as a
// file-level `module X;` does.
module app;

module math {
    pub int square(int x) { return x * x; }
    int helper(int x) { return x + 1; }        // private to module `math`
    pub int bump(int x) { return helper(x); }  // intra-module call, no import
}

import math.square;
import math.bump;

unit main() {
    log(square(5));      // 25 - imported free-fn call
    log(math.bump(9));   // 10 - qualified call into a module-private helper
}
