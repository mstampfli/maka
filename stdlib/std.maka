// =====================================================================
// More string + filesystem helpers.
// =====================================================================
extern "__maka_rt_str_substring"   string __str_substring  (string s, int start, int len);
extern "__maka_rt_file_mtime_ns"   int    __file_mtime_ns  (string path);
extern "__maka_rt_str_starts_with" int    __str_starts_with(string s, string prefix);
extern "__maka_rt_str_ends_with"   int    __str_ends_with  (string s, string suffix);
