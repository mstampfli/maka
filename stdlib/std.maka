// Maka standard library.
//
// Imported on demand: `import std.{Option, Result, str_len, str_eq};`
// (or any subset).  Genuine compiler builtins (log, panic, free, spawn,
// join, read_line, read_int, `+` on strings, `.len` on slices) live in
// the codegen crate and are not declared here; they're always in scope.
//
// One exception: `Option<T>` is also looked up by the `for x in
// user_iterator` desugaring even when not explicitly imported, since
// `for x in slice` doesn't require an import either.

module std;

// ---- generic tagged options --------------------------------------------

pub enum Option<T> {
    Some { T value },
    None,
}

pub enum Result<T, E> {
    Ok  { T value },
    Err { E err   },
}

// ---- string helpers ----------------------------------------------------

extern "strlen" usize __str_len(string s);
extern "strcmp" i32   __str_cmp(string a, string b);

pub usize str_len(string s)              { return __str_len(s); }
pub bool  str_eq (string a, string b)    { return __str_cmp(a, b) == 0; }

// ---- concurrency: sleep / slice composition / par_* --------------------
//
// The compiler emits `__maka_sleep_ns`, `__maka_join_all_i64`,
// `__maka_select_first_i64` in the prologue.  These thin wrappers give
// them Maka-friendly signatures.  See CONCURRENCY.md for the full
// concurrency model — `spawn` / `thread` / `job` plus this composition
// surface.

extern "__maka_sleep_ns" unit __sleep_ns(int nanos);

// Sleep the current task/thread for the given number of milliseconds.
pub unit sleep_ms(int ms) {
    __sleep_ns(ms * 1000000);
}

// Sleep for a sub-millisecond duration (microseconds).
pub unit sleep_us(int us) {
    __sleep_ns(us * 1000);
}

// IO event flags for wait_fd.
pub constexpr int EV_READ  = 1;
pub constexpr int EV_WRITE = 2;

// IO primitives.  See CONCURRENCY.md.  Inside a fiber these yield to the
// scheduler; outside they fall back to poll() / blocking read/write.
extern "__maka_wait_fd"          unit __wait_fd(int fd, int events);
extern "__maka_wait_fd_timeout"  int  __wait_fd_timeout(int fd, int events, int ms);
extern "__maka_set_nonblock"     int  __set_nonblock(int fd);
extern "__maka_read_async"       int  __read_async(int fd, *mut unit buf, int cap);
extern "__maka_write_async"      int  __write_async(int fd, *mut unit buf, int len);
extern "__maka_tcp_listen"       int  __tcp_listen(int port, int backlog);
extern "__maka_tcp_listen_any"   int  __tcp_listen_any(int port, int backlog);
extern "__maka_tcp_accept_async" int  __tcp_accept(int listen_fd);
extern "__maka_tcp_connect_v4"   int  __tcp_connect_v4(int a, int b, int c, int d, int port);
extern "__maka_close_fd"         int  __close_fd(int fd);
extern "__maka_dns_resolve_v4"   int  __dns_resolve_v4(string host);
extern "__maka_unix_listen"      int  __unix_listen(string path, int backlog);
extern "__maka_unix_connect"     int  __unix_connect(string path);
extern "__maka_pipe_create"      int  __pipe_create();
extern "__maka_pipe_write_fd"    int  __pipe_write_fd();

// Non-blocking pipe pair.  Returns the read fd; immediately after, call
// `pipe_write_fd()` to grab the matching write fd.  Both fds are O_NONBLOCK
// so read_async / write_async work directly.  pipe_write_fd is stored in a
// per-thread stash, so consume it before another pipe_create call on the
// same thread.
pub int pipe_create  () { return __pipe_create(); }
pub int pipe_write_fd() { return __pipe_write_fd(); }

// TLS client (OpenSSL).  Requires the C source to be compiled with
// -DMAKA_TLS and linked with `-l ssl -l crypto` — otherwise these
// helpers return -1 / NULL so user programs still compile cleanly.
extern "__maka_tls_server_init"        int   __tls_server_init(string cert_pem, string key_pem);
extern "__maka_tls_server_accept_new"  *unit __tls_server_accept_new(int fd);
extern "__maka_tls_client_new"         *unit __tls_client_new(int fd, string hostname);
extern "__maka_tls_handshake"   int  __tls_handshake(*unit ssl);
extern "__maka_tls_read"        int  __tls_read(*unit ssl, *mut unit buf, int cap);
extern "__maka_tls_write"       int  __tls_write(*unit ssl, *mut unit buf, int len);
extern "__maka_tls_close"       unit __tls_close(*unit ssl);

pub int   tls_server_init(string cert_pem_path, string key_pem_path) { return __tls_server_init(cert_pem_path, key_pem_path); }
pub *unit tls_server_accept(int client_fd)                            { return __tls_server_accept_new(client_fd); }
pub *unit tls_client_new(int fd, string hostname)               { return __tls_client_new(fd, hostname); }
pub int   tls_handshake (*unit ssl)                              { return __tls_handshake(ssl); }
pub int   tls_read      (*unit ssl, *mut unit buf, int cap)      { return __tls_read(ssl, buf, cap); }
pub int   tls_write     (*unit ssl, *mut unit buf, int len)      { return __tls_write(ssl, buf, len); }
pub unit  tls_close     (*unit ssl)                              { __tls_close(ssl); }

// Unix domain sockets — pathname-based IPC.  Same stream semantics as TCP,
// so accept_async / read_async / write_async / close_fd work on the
// returned fd identically.
pub int unix_listen (string path, int backlog) { return __unix_listen(path, backlog); }
pub int unix_connect(string path)               { return __unix_connect(path); }

// Minimal HTTP/1.x request parser.  `http_parse(buf, len)` returns 0 on
// success (full headers present in buf) or -1 if more bytes are needed.
// After a successful parse, the offset+length pairs and the body offset
// are available via the getter calls below — they read from per-thread
// state set by the most recent parse, so don't call other http_parse
// concurrently on the same thread.
extern "__maka_http_parse"               int __http_parse(string buf, int len);
extern "__maka_http_method_off_g"        int __http_method_off();
extern "__maka_http_method_len_g"        int __http_method_len();
extern "__maka_http_path_off_g"          int __http_path_off();
extern "__maka_http_path_len_g"          int __http_path_len();
extern "__maka_http_body_off_g"          int __http_body_off();
extern "__maka_http_content_length_g"    int __http_content_length();

pub int http_parse           (string buf, int len) { return __http_parse(buf, len); }
pub int http_method_off      ()                    { return __http_method_off(); }
pub int http_method_len      ()                    { return __http_method_len(); }
pub int http_path_off        ()                    { return __http_path_off(); }
pub int http_path_len        ()                    { return __http_path_len(); }
pub int http_body_off        ()                    { return __http_body_off(); }
pub int http_content_length  ()                    { return __http_content_length(); }
extern "__maka_file_open"        int  __file_open(string path, int flags, int mode);
extern "__maka_file_read_async"  int  __file_read_async(int fd, *mut unit buf, int cap, int offset);
extern "__maka_file_write_async" int  __file_write_async(int fd, *mut unit buf, int len, int offset);

// File async IO via an offload thread per request.  open() is synchronous
// (regular file opens are quick); read/write yield via an eventfd that a
// dedicated worker pthread signals after pread/pwrite returns.
//
// Flag bit values (from <fcntl.h>):
//   0 = O_RDONLY, 1 = O_WRONLY, 2 = O_RDWR
//   64 = O_CREAT, 512 = O_TRUNC
// `mode` is the file mode (e.g. 0o644 = 420) when O_CREAT is set; pass 0
// otherwise.
pub int file_open       (string path, int flags, int mode)                 { return __file_open(path, flags, mode); }
pub int file_read_async (int fd, *mut unit buf, int cap, int offset)        { return __file_read_async(fd, buf, cap, offset); }
pub int file_write_async(int fd, *mut unit buf, int len, int offset)        { return __file_write_async(fd, buf, len, offset); }

// Resolve a hostname to its first IPv4 address.  Returns the packed
// 32-bit address (e.g. 192.168.1.1 → 0xC0A80101) or -1 on failure.
// Synchronous — wrap in spawn_pool() if you don't want the calling
// fiber to block.
pub int dns_resolve_v4(string host) { return __dns_resolve_v4(host); }
extern "__maka_udp_open"         int  __udp_open(int port);
extern "__maka_udp_send_v4"      int  __udp_send_v4(int fd, int a, int b, int c, int d, int port, *mut unit buf, int len);
extern "__maka_udp_recv_async"   int  __udp_recv_async(int fd, *mut unit buf, int cap);
extern "__maka_signalfd_open"    int  __signalfd_open(int signum);
extern "__maka_signalfd_recv"    int  __signalfd_recv(int fd);
extern "__maka_timerfd_create"   int  __timerfd_create(int initial_ns, int interval_ns);
extern "__maka_timerfd_recv"     int  __timerfd_recv(int fd);
extern "__maka_eventfd_create"   int  __eventfd_create(int initial);
extern "__maka_eventfd_signal"   int  __eventfd_signal(int fd, int n);
extern "__maka_eventfd_recv"     int  __eventfd_recv(int fd);
extern "__maka_inotify_open"     int  __inotify_open();
extern "__maka_inotify_add"      int  __inotify_add(int fd, string path, int mask);
extern "__maka_inotify_recv"     int  __inotify_recv(int fd);

// File-watch via inotify (Linux).  Common masks:
//   1     = IN_ACCESS   (file was accessed)
//   2     = IN_MODIFY   (file was modified)
//   8     = IN_CLOSE_WRITE
//   256   = IN_CREATE
//   512   = IN_DELETE
pub int inotify_open    ()                                   { return __inotify_open(); }
pub int inotify_add_path(int fd, string path, int mask)      { return __inotify_add(fd, path, mask); }
pub int inotify_recv_async(int fd)                            { return __inotify_recv(fd); }

// eventfd: a kernel counter useful as a wake-up signal between fibers and
// threads.  event_fd_signal(fd, n) adds n to the counter and wakes any
// reader; event_recv_async returns the accumulated count, resetting to 0.
pub int event_fd_create  (int initial)         { return __eventfd_create(initial); }
pub int event_fd_signal  (int fd, int n)       { return __eventfd_signal(fd, n); }
pub int event_recv_async (int fd)              { return __eventfd_recv(fd); }

// Periodic timer fd.  `initial_ns` is the delay until the first fire;
// `interval_ns` is the recurring period (0 = one-shot).  timer_recv_async
// returns the number of times the timer has fired since the last call —
// always >= 1 (or -1 on error).
pub int timer_fd_create   (int initial_ns, int interval_ns) { return __timerfd_create(initial_ns, interval_ns); }
pub int timer_recv_async  (int fd)                          { return __timerfd_recv(fd); }

// Signal handling via signalfd (Linux).  signal_fd_open(signum) returns
// an fd that becomes readable when the signal is delivered; the signal
// is blocked from default-handling.  signal_recv_async(fd) yields until
// the signal arrives and returns the signal number.
pub int signal_fd_open    (int signum) { return __signalfd_open(signum); }
pub int signal_recv_async (int fd)     { return __signalfd_recv(fd); }

// UDP datagram helpers.  Port 0 picks an ephemeral local port.
pub int udp_open      (int port)                                       { return __udp_open(port); }
pub int udp_send_v4   (int fd, int a, int b, int c, int d, int port, *mut unit buf, int len) {
    return __udp_send_v4(fd, a, b, c, d, port, buf, len);
}
pub int udp_recv_async(int fd, *mut unit buf, int cap)                 { return __udp_recv_async(fd, buf, cap); }

// TCP helpers.  All sockets are returned in non-blocking mode so the
// reactor primitives (wait_fd, read_async, write_async) work directly.
// tcp_listen binds 127.0.0.1 — safer default; Windows firewall stays quiet.
// Use tcp_listen_any when you need to accept from external interfaces.
pub int tcp_listen      (int port, int backlog)         { return __tcp_listen(port, backlog); }
pub int tcp_listen_any  (int port, int backlog)         { return __tcp_listen_any(port, backlog); }
pub int tcp_accept_async(int listen_fd)                  { return __tcp_accept(listen_fd); }
pub int tcp_connect_v4  (int a, int b, int c, int d, int port) { return __tcp_connect_v4(a, b, c, d, port); }
pub int close_fd        (int fd)                         { return __close_fd(fd); }

pub data TcpListener { int fd; }
pub data TcpStream   { int fd; }

pub TcpListener tcp_listener_open(int port, int backlog) {
    TcpListener l = { fd = tcp_listen(port, backlog) };
    return l;
}
pub TcpStream tcp_listener_accept(TcpListener l) {
    TcpStream s = { fd = tcp_accept_async(l.fd) };
    return s;
}
pub unit tcp_listener_close(TcpListener l) { _ = close_fd(l.fd); }

pub TcpStream tcp_dial_v4(int a, int b, int c, int d, int port) {
    TcpStream s = { fd = tcp_connect_v4(a, b, c, d, port) };
    return s;
}
pub int  tcp_stream_read (TcpStream s, *mut unit buf, int cap) { return read_async(s.fd, buf, cap); }
pub int  tcp_stream_write(TcpStream s, *mut unit buf, int len) { return write_async(s.fd, buf, len); }
pub unit tcp_stream_close(TcpStream s) { _ = close_fd(s.fd); }

pub unit wait_fd        (int fd, int events)              { __wait_fd(fd, events); }
// Returns true if the fd became ready within `ms`, false on timeout.
pub bool wait_fd_timeout(int fd, int events, int ms)      { return __wait_fd_timeout(fd, events, ms) != 0; }
pub int  set_nonblock   (int fd)                           { return __set_nonblock(fd); }
pub int  read_async     (int fd, *mut unit buf, int cap)   { return __read_async(fd, buf, cap); }
pub int  write_async    (int fd, *mut unit buf, int len)   { return __write_async(fd, buf, len); }

// ---- fiber-aware sync primitives ----------------------------------------
//
// All four park the caller via the scheduler when contended so a fiber
// waiting on a mutex / wait-group doesn't freeze the whole worker.
// Outside a fiber they fall back to pthread-style blocking, so the same
// calls work from any tier.

extern "maka_fmutex_new"     *unit __fmutex_new();
extern "maka_fmutex_lock"    unit  __fmutex_lock(*unit m);
extern "maka_fmutex_unlock"  unit  __fmutex_unlock(*unit m);
extern "maka_fmutex_destroy" unit  __fmutex_destroy(*unit m);

pub *unit mutex_new()                      { return __fmutex_new(); }
pub unit  mutex_lock   (*unit m)           { __fmutex_lock(m); }
pub unit  mutex_unlock (*unit m)           { __fmutex_unlock(m); }
pub unit  mutex_destroy(*unit m)           { __fmutex_destroy(m); }

extern "maka_wg_new"     *unit __wg_new();
extern "maka_wg_add"     unit  __wg_add(*unit w, int n);
extern "maka_wg_done"    unit  __wg_done(*unit w);
extern "maka_wg_wait"    unit  __wg_wait(*unit w);
extern "maka_wg_destroy" unit  __wg_destroy(*unit w);

pub *unit wg_new()                          { return __wg_new(); }
pub unit  wg_add    (*unit w, int n)        { __wg_add(w, n); }
pub unit  wg_done   (*unit w)               { __wg_done(w); }
pub unit  wg_wait   (*unit w)               { __wg_wait(w); }
pub unit  wg_destroy(*unit w)               { __wg_destroy(w); }

extern "maka_once_new"     *unit __once_new();
extern "maka_once_destroy" unit  __once_destroy(*unit o);

pub *unit once_new()                            { return __once_new(); }
pub unit  once_destroy(*unit o)                 { __once_destroy(o); }
// `once_do(o, init)` is a compiler builtin — it splits the `unit()` Callable
// into code+env at the call site so the runtime entry can take two plain
// pointers (avoids a C type-mismatch with the synthesized Callable_unit_).

extern "maka_atomic_i64_new"     *unit __atomic_new(int v);
extern "maka_atomic_i64_load"    int   __atomic_load(*unit a);
extern "maka_atomic_i64_store"   unit  __atomic_store(*unit a, int v);
extern "maka_atomic_i64_add"     int   __atomic_add(*unit a, int delta);
extern "maka_atomic_i64_cas"     int   __atomic_cas(*unit a, int expected, int desired);
extern "maka_atomic_i64_destroy" unit  __atomic_destroy(*unit a);

// Byte-channel: variable-size items, set per channel via item_size.  Use
// these to build typed channels in user code — wrap the *unit handle in a
// `data MyTypeChan { *unit h }`, cast `&value as raw *mut unit` for send,
// `&mut out as raw *mut unit` for recv.  v1: unbounded, blocks pthread on
// empty recv (not yet fiber-aware — use spawn_pool on receiver to keep
// the fiber scheduler running).
extern "maka_chan_bytes_new"     *unit __chan_bytes_new(int item_size);
extern "maka_chan_bytes_send"    unit  __chan_bytes_send(*unit ch, *unit src);
extern "maka_chan_bytes_recv"    unit  __chan_bytes_recv(*unit ch, *unit dst);
extern "maka_chan_bytes_count"   int   __chan_bytes_count(*unit ch);
extern "maka_chan_bytes_close"   unit  __chan_bytes_close(*unit ch);
extern "maka_chan_bytes_destroy" unit  __chan_bytes_destroy(*unit ch);

pub *unit chan_bytes_new    (int item_size)              { return __chan_bytes_new(item_size); }
pub unit  chan_bytes_send   (*unit ch, *unit src)        { __chan_bytes_send(ch, src); }
pub unit  chan_bytes_recv   (*unit ch, *unit dst)        { __chan_bytes_recv(ch, dst); }
pub int   chan_bytes_count  (*unit ch)                   { return __chan_bytes_count(ch); }
pub unit  chan_bytes_close  (*unit ch)                   { __chan_bytes_close(ch); }
pub unit  chan_bytes_destroy(*unit ch)                   { __chan_bytes_destroy(ch); }

// Typed int channel — the common case, no need for users to wrap
// chan_bytes themselves.  Item size is 8 (one i64).
pub data IntChan { *unit h; }
pub IntChan chan_int_new()                    { IntChan c = { h = __chan_bytes_new(8) }; return c; }
pub unit    chan_int_send  (IntChan c, int v) { mut int x = v; __chan_bytes_send(c.h, &mut x as *mut unit); }
pub int     chan_int_recv  (IntChan c)        { mut int out = 0; __chan_bytes_recv(c.h, &mut out as *mut unit); return out; }
pub int     chan_int_count (IntChan c)        { return __chan_bytes_count(c.h); }
pub unit    chan_int_close (IntChan c)        { __chan_bytes_close(c.h); }
pub unit    chan_int_destroy(IntChan c)       { __chan_bytes_destroy(c.h); }

// Typed float channel (8-byte f64 items).
pub data FloatChan { *unit h; }
pub FloatChan chan_float_new()                      { FloatChan c = { h = __chan_bytes_new(8) }; return c; }
pub unit      chan_float_send  (FloatChan c, float v) { mut float x = v; __chan_bytes_send(c.h, &mut x as *mut unit); }
pub float     chan_float_recv  (FloatChan c)         { mut float out = 0.0; __chan_bytes_recv(c.h, &mut out as *mut unit); return out; }
pub int       chan_float_count (FloatChan c)         { return __chan_bytes_count(c.h); }
pub unit      chan_float_close (FloatChan c)         { __chan_bytes_close(c.h); }
pub unit      chan_float_destroy(FloatChan c)        { __chan_bytes_destroy(c.h); }

// Generic par_map_bytes — chunks N items across the job pool, calling
// `body(in_item_ptr, out_item_ptr)` for every item.  `par_map_bytes` is
// a compiler builtin (FuncId u32::MAX - 38) so codegen can split the
// Callable's code/env at the call site, just like `once_do` and the
// par_* family.  Returns a freshly-malloc'd buffer of n * out_sz bytes;
// free yourself when done.

pub *unit atomic_new   (int v)                              { return __atomic_new(v); }
// `atomic_get` / `atomic_set` instead of load/store to avoid clashing with
// the C11 <stdatomic.h> macros of those names.
pub int   atomic_get   (*unit a)                            { return __atomic_load(a); }
pub unit  atomic_set   (*unit a, int v)                     { __atomic_store(a, v); }
pub int   atomic_add   (*unit a, int delta)                 { return __atomic_add(a, delta); }
pub bool  atomic_cas   (*unit a, int expected, int desired) { return __atomic_cas(a, expected, desired) != 0; }
pub unit  atomic_destroy(*unit a)                           { __atomic_destroy(a); }

// par_for_range and par_reduce_int are compiler builtins (like `spawn`):
//   par_for_range(start, end, body)
//     runs `body(i)` for every i in [start, end), chunked across the job
//     pool.  Body is a `unit(int)` closure.
//   par_reduce_int(start, end, init, combine)
//     folds [start, end) into an `int` accumulator using a `(int, int) -> int`
//     combine function.  Returns the final accumulator.
//   yield_now() — cooperatively yields the current fiber to the scheduler
//     (no-op outside a fiber context).
//
// These are wired in sema/typeck.rs as name-recognized builtins; the
// runtime entries live in the codegen prologue.
